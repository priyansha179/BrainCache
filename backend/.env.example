# Copy this file to .env and set a unique random secret before running the API.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=30

# SQLite is the default. For PostgreSQL, install psycopg[binary] and set DATABASE_URL.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/braincache

# Optional local AI (install Ollama and pull the model first: ollama pull llama3.2)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081
